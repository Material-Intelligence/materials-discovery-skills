# What the source distribution carries beyond the package itself.
#
# Without this file setuptools ships a partial test suite (the files matching tests/test*.py but
# not conftest.py or __init__.py), so `pytest` inside an unpacked sdist fails on import before it
# has collected anything, and the README that does ship links to documents that do not.

include LICENSE
include NOTICE.md
include CITATION.cff
include MANIFEST.in

recursive-include tests *.py
recursive-include examples *.py *.md *.csv *.vasp
recursive-include docs *.md
recursive-include skills *.md
recursive-include tools *.py

prune .github
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
